{
  "name": "contra-scrapper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape": "node --env-file-if-exists=.env.local scraper/run.ts",
    "schedule:install": "powershell -ExecutionPolicy Bypass -File scripts/schedule.ps1",
    "schedule:remove": "powershell -ExecutionPolicy Bypass -File scripts/schedule.ps1 -Remove",
    "scrape:pending": "node scraper/pending.ts",
    "scrape:fetch": "node --env-file-if-exists=.env.local scraper/fetch.ts",
    "scrape:ci": "node scraper/fetch.ts && node scraper/run.ts",
    "notify": "node --env-file-if-exists=.env.local scraper/notify.ts",
    "contra:auth": "node scripts/contra-auth.ts",
    "test": "node --test \"scraper/**/*.test.ts\""
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
