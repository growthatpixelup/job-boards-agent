# Copy to .env.local (optional). Jobs are fetched via the Contra MCP — no cookie needed.

# ICP classifier: regex (default, free) | none (keeps every job) | anthropic | openai
# LLM classifiers read every job themselves; the regex rules only stand in when a call fails.
ICP_CLASSIFIER=regex
# Model for LLM classifiers. anthropic defaults to claude-sonnet-5-5; openai requires a value.
ICP_MODEL=

# For ICP_CLASSIFIER=anthropic and LEAD_LOOKUP=anthropic (the SDK is already a dependency)
ANTHROPIC_API_KEY=
# For ICP_CLASSIFIER=openai:     npm install openai
OPENAI_API_KEY=

# Full-time roles: look up the company's website, LinkedIn, X and founders with Claude + web search. Off when empty.
LEAD_LOOKUP=
# Model for the lookup (default claude-sonnet-5-5).
LEAD_MODEL=
# The lead sheet's Apps Script web app (scripts/leads-sheet.gs). `npm run sheet` skips when the URL is empty.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=
# Optional: the lead sheet's link, shown in Slack.
LEADS_SHEET_URL=
