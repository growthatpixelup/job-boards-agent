# Copy to .env.local (optional). Jobs are fetched via the Contra MCP — no cookie needed.

# ICP classifier: none (default, keeps every job) | regex (free) | anthropic | openai
ICP_CLASSIFIER=none
# Model for LLM classifiers. anthropic defaults to claude-opus-5-5; openai requires a value.
ICP_MODEL=
# LLM classifiers skip jobs the regex rules hard-reject. Set false to send every job to the LLM.
ICP_LLM_PREFILTER=true

# For ICP_CLASSIFIER=anthropic:  npm install @anthropic-ai/sdk
ANTHROPIC_API_KEY=
# For ICP_CLASSIFIER=openai:     npm install openai
OPENAI_API_KEY=
